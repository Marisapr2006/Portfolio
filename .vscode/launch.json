{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portfolio: dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "(https?://localhost:4321/?\\S*)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
