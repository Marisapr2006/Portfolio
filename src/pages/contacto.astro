---
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
---

<BaseLayout
  title="Contacto"
  description="Contacta con Marisa Peña Rey por email, LinkedIn o GitHub. Desarrolladora web full-stack junior en Las Palmas de Gran Canaria, disponible para remoto."
>
  <section class="page">
    <div class="container">
      <div class="page__header">
        <p class="page__eyebrow">// 03 — Contacto</p>
        <h1 class="page__title">Contacto</h1>
        <p class="page__lead">
          La forma más rápida es un email. Si prefieres, también estoy en LinkedIn y GitHub.
        </p>
      </div>

      <div class="contact-grid">
        <div class="contact-block contact-block--email">
          <p class="mono-label">// email</p>
          <h2 class="contact-block__title">Escríbeme</h2>
          <p class="contact-block__text">
            {site.email}
            <br />
            {site.availability} · Remoto
          </p>
          <CopyEmail />
        </div>

        <div class="contact-block">
          <p class="mono-label">// redes</p>
          <h2 class="contact-block__title">Redes</h2>
          <ul class="contact-block__list">
            <li>
              <a href={site.github}>GitHub</a>
            </li>
            <li>
              <a href={site.linkedin}>LinkedIn</a>
            </li>
          </ul>
        </div>

        <div class="contact-block">
          <p class="mono-label">// dónde</p>
          <h2 class="contact-block__title">Ubicación</h2>
          <p class="contact-block__text">
            {site.location}
            <br />
            {site.availability} · Remoto
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-6);
  }

  .contact-block {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .contact-block__title {
    font-size: var(--text-xl);
  }

  .contact-block__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .contact-block__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
