---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { sortProjects } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = sortProjects(await getCollection('projects'));
---

<BaseLayout
  title="Proyectos"
  description="Casos de estudio de Marisa Peña Rey: contexto, decisiones técnicas y resultado de cada proyecto web. Laravel, JavaScript y MySQL."
>
  <section class="page">
    <div class="container">
      <div class="page__header">
        <p class="page__eyebrow">// 01 — Proyectos</p>
        <h1 class="page__title">Proyectos</h1>
        <p class="page__lead">
          Casos de estudio con contexto, restricciones, decisiones y resultado. Sin capturas
          decorativas: qué hice, por qué y qué aprendí.
        </p>
      </div>

      {projects.length > 0 ? (
        <div class="project-list">
          {projects.map((project, index) => (
            <ProjectCard project={project} index={index} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <p class="page__lead">
          Estoy documentando el primer caso. Se publica en las próximas semanas.
        </p>
      )}

      {projects.length === 1 && (
        <p class="project-list__note">
          El segundo caso, mi proyecto final de DAW, está en preparación.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .project-list {
    display: grid;
  }

  .project-list__note {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
