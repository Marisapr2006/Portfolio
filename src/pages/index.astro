---
import { getCollection } from 'astro:content';
import AboutBlock from '../components/AboutBlock.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ToolsBento from '../components/ToolsBento.astro';
import { processSteps } from '../data/process';
import { sortProjects } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = sortProjects(await getCollection('projects', ({ data }) => data.featured));
const mainCase = projects[0];

const skillsRibbon = ['Laravel', 'JavaScript', 'MySQL', 'TypeScript', 'Accesibilidad', 'Pruebas'];
---

<BaseLayout>
  <Hero />

  <div class="ribbons" aria-hidden="true">
    <div class="ribbons__row">
      <Marquee items={skillsRibbon} variant="solid" />
    </div>
  </div>

  <section class="home-section" id="trabajo" aria-labelledby="trabajo-title">
    <div class="container">
      <SectionHeading index="1" title="Trabajo seleccionado" id="trabajo-title" />

      {projects.length > 0 ? (
        <div class="project-list">
          {projects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>
      ) : (
        <p class="page__lead">
          Estoy documentando el primer caso. Se publica en las próximas semanas.
        </p>
      )}

      <div class="home-section__footer">
        <ArrowLink href="/proyectos/">Ver todos los proyectos</ArrowLink>
        {projects.length === 1 && (
          <p class="home-section__note">
            El segundo caso, mi proyecto final de DAW, está en preparación.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="home-section" id="sobre-mi" aria-labelledby="sobre-title">
    <div class="container">
      <SectionHeading index="2" title="Sobre mí" id="sobre-title" />
      <AboutBlock experienceHref="#experiencia" />
    </div>
  </section>

  <section class="home-section" id="experiencia" aria-labelledby="experiencia-title">
    <div class="container">
      <SectionHeading index="3" title="Experiencia y formación" id="experiencia-title" />
      <ExperienceTimeline />
    </div>
  </section>

  <section class="home-section" aria-labelledby="proceso-title">
    <div class="container">
      <SectionHeading index="4" title="Cómo trabajo" id="proceso-title" />

      <div class="process-grid">
        {processSteps.map((step) => (
          <article class="process-step" data-reveal>
            <p class="process-step__number">{step.number}</p>
            <h3 class="process-step__title">{step.title}</h3>
            <p class="process-step__text">{step.text}</p>
          </article>
        ))}
      </div>

      <figure class="artifact" data-reveal>
        <blockquote class="artifact__quote">
          <p>
            El portfolio no es una entrega académica ni una aplicación con backend. Es una pieza de
            comunicación profesional y, a la vez, una demostración del criterio técnico de su
            autora.
          </p>
        </blockquote>
        <figcaption class="artifact__caption">
          Fragmento de <cite>docs/Spec.md</cite>
        </figcaption>
      </figure>

      {mainCase && (
        <div class="home-section__link">
          <ArrowLink href={`/proyectos/${mainCase.id}/`}>Leer el caso completo</ArrowLink>
        </div>
      )}
    </div>
  </section>

  <section class="home-section" aria-labelledby="herramientas-title">
    <div class="container">
      <SectionHeading index="5" title="Con qué trabajo" id="herramientas-title" />
      <ToolsBento />
    </div>
  </section>
</BaseLayout>

<style>
  .ribbons {
    display: block;
    margin-block: var(--space-4) var(--space-6);
    padding-block: var(--space-5);
    overflow-x: clip;
  }

  .ribbons__row {
    width: 106%;
    margin-left: -3%;
    transform: rotate(-2deg);
  }

  .home-section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .home-section__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .home-section__note {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .home-section__link {
    margin-top: var(--space-6);
  }

  .project-list {
    display: grid;
  }

  .process-grid {
    display: grid;
    gap: var(--space-6);
  }

  .process-step {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard);
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .process-step:hover {
    transform: translateY(-5px) rotate(-0.6deg);
  }

  .process-step__number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .process-step__title {
    font-size: var(--text-xl);
  }

  .process-step__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .artifact {
    margin: var(--space-8) 0 0;
    padding: var(--space-6);
    border: var(--border-width) dashed var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface-sunken);
  }

  .artifact__quote {
    max-width: 44ch;
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .artifact__caption {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  @media (min-width: 720px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .process-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
