---
import { getCollection } from 'astro:content';
import ArrowLink from '../components/ArrowLink.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { processSteps } from '../data/process';
import { sortProjects } from '../data/projects';
import { site } from '../data/site';
import { stackGroups } from '../data/stack';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = sortProjects(await getCollection('projects', ({ data }) => data.featured));
const mainCase = projects[0];
---

<BaseLayout>
  <Hero />

  <section class="home-section" aria-labelledby="trabajo-title">
    <div class="container">
      <SectionHeading index="01" title="Trabajo seleccionado" id="trabajo-title" />

      {projects.length > 0 ? (
        <div class="project-list">
          {projects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>
      ) : (
        <p class="page__lead">
          Estoy documentando el primer caso. Se publica en las próximas semanas.
        </p>
      )}

      <div class="home-section__footer">
        <ArrowLink href="/proyectos/">Ver todos los proyectos</ArrowLink>
        {projects.length === 1 && (
          <p class="home-section__note">
            El segundo caso, mi proyecto final de DAW, está en preparación.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="proceso-title">
    <div class="container">
      <SectionHeading index="02" title="Cómo trabajo" id="proceso-title" />

      <div class="process-grid">
        {processSteps.map((step) => (
          <article class="process-step">
            <p class="process-step__number">{step.number}</p>
            <h3 class="process-step__title">{step.title}</h3>
            <p class="process-step__text">{step.text}</p>
          </article>
        ))}
      </div>

      <figure class="artifact">
        <blockquote class="artifact__quote">
          <p>
            El portfolio no es una entrega académica ni una aplicación con backend. Es una pieza de
            comunicación profesional y, a la vez, una demostración del criterio técnico de su
            autora.
          </p>
        </blockquote>
        <figcaption class="artifact__caption">
          Fragmento de <cite>docs/Spec.md</cite>
        </figcaption>
      </figure>

      {mainCase && (
        <div class="home-section__link">
          <ArrowLink href={`/proyectos/${mainCase.id}/`}>Leer el caso completo</ArrowLink>
        </div>
      )}
    </div>
  </section>

  <section class="home-section" aria-labelledby="stack-title">
    <div class="container">
      <SectionHeading index="03" title="Stack" id="stack-title" />

      <div class="stack-grid">
        {stackGroups.map((group) => (
          <div class="stack-group">
            <h3 class="stack-group__title">{group.title}</h3>
            <ul class="stack-group__list">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-cta" aria-labelledby="contacto-title">
    <div class="container home-cta__inner">
      <p class="page__eyebrow">04 — Contacto</p>
      <h2 class="home-cta__title" id="contacto-title">
        ¿Hablamos?
      </h2>
      <p class="home-cta__text">
        Busco mi primera oportunidad como desarrolladora. Si tienes un equipo, un proyecto o una
        duda, escríbeme.
      </p>
      <div class="actions home-cta__actions">
        <a class="button button--primary" href={`mailto:${site.email}`}>
          Escríbeme
        </a>
        <a class="button button--secondary" href="/contacto/">
          Ver contacto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--color-border);
  }

  .home-section__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .home-section__note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .home-section__link {
    margin-top: var(--space-5);
  }

  .project-list {
    display: grid;
  }

  .process-grid {
    display: grid;
    gap: var(--space-5);
  }

  .process-step {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .process-step__number {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .process-step__title {
    font-size: var(--text-xl);
  }

  .process-step__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .artifact {
    margin: var(--space-7) 0 0;
    padding: var(--space-5) 0 var(--space-5) var(--space-5);
    border-left: 2px solid var(--color-primary);
  }

  .artifact__quote {
    max-width: 44ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .artifact__caption {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .stack-grid {
    display: grid;
    gap: var(--space-6);
  }

  .stack-group {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .stack-group__title {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stack-group__list {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .home-cta {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .home-cta__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
  }

  .home-cta__title {
    font-size: var(--text-3xl);
  }

  .home-cta__text {
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .home-cta__actions {
    margin-top: var(--space-3);
  }

  @media (min-width: 720px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  @media (min-width: 1100px) {
    .process-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 640px) {
    .stack-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .stack-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
