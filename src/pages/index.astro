---
import { getCollection } from 'astro:content';
import ArrowLink from '../components/ArrowLink.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessGrid from '../components/ProcessGrid.astro';
import StackGrid from '../components/StackGrid.astro';
import { sortProjects } from '../data/projects';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = sortProjects(await getCollection('projects', ({ data }) => data.featured));
const mainCase = projects[0];
---

<BaseLayout>
  <Hero />

  <section class="home-section" aria-labelledby="trabajo-title">
    <div class="container">
      <SectionHeading index="01" title="Trabajo seleccionado" id="trabajo-title" />

      {projects.length > 0 ? (
        <div class="project-list">
          {projects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>
      ) : (
        <p class="page__lead">
          Estoy documentando el primer caso. Se publica en las próximas semanas.
        </p>
      )}

      <div class="home-section__footer">
        <ArrowLink href="/proyectos/">Ver todos los proyectos</ArrowLink>
        {projects.length === 1 && (
          <p class="home-section__note">
            El segundo caso, mi proyecto final de DAW, está en preparación.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="proceso-title">
    <div class="container">
      <SectionHeading index="02" title="Cómo trabajo" id="proceso-title" />

      <ProcessGrid />

      <figure class="artifact">
        <div class="artifact__bar" aria-hidden="true">
          <span class="artifact__dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="artifact__file">spec.md</span>
        </div>
        <blockquote class="artifact__quote">
          <p>
            El portfolio no es una entrega académica ni una aplicación con backend. Es una pieza de
            comunicación profesional y, a la vez, una demostración del criterio técnico de su
            autora.
          </p>
        </blockquote>
        <figcaption class="artifact__caption">
          Fragmento de <cite>docs/Spec.md</cite>
        </figcaption>
      </figure>

      {mainCase && (
        <div class="home-section__link">
          <ArrowLink href={`/proyectos/${mainCase.id}/`}>Leer el caso completo</ArrowLink>
        </div>
      )}
    </div>
  </section>

  <section class="home-section" aria-labelledby="stack-title">
    <div class="container">
      <SectionHeading index="03" title="Stack" id="stack-title" />

      <StackGrid />
    </div>
  </section>

  <section class="home-cta" aria-labelledby="contacto-title">
    <div class="container home-cta__inner">
      <p class="page__eyebrow">// 04 — Contacto</p>
      <h2 class="home-cta__title" id="contacto-title">
        ¿Hablamos?
      </h2>
      <p class="home-cta__text">
        Busco mi primera oportunidad como desarrolladora. Si tienes un equipo, un proyecto o una
        duda, escríbeme.
      </p>
      <div class="actions home-cta__actions">
        <a class="button button--primary" href={`mailto:${site.email}`}>
          Escríbeme
        </a>
        <a class="button button--secondary" href="/contacto/">
          Ver contacto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--color-border);
  }

  .home-section__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .home-section__note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .home-section__link {
    margin-top: var(--space-5);
  }

  .project-list {
    display: grid;
  }

  .artifact {
    margin: var(--space-7) 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-code-bg);
    color: var(--color-code-text);
  }

  .artifact__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.25rem;
    padding-inline: var(--space-3);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    background: var(--color-code-bar);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .artifact__dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .artifact__dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-code-muted);
    opacity: 0.55;
  }

  .artifact__dots span:nth-child(1) {
    background: var(--color-primary);
    opacity: 1;
  }

  .artifact__dots span:nth-child(2) {
    background: var(--color-code-string);
    opacity: 0.8;
  }

  .artifact__file {
    color: var(--color-code-text);
  }

  .artifact__quote {
    margin: 0;
    padding: var(--space-5);
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
    line-height: 1.7;
  }

  .artifact__caption {
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid rgb(255 255 255 / 10%);
    color: var(--color-code-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .home-cta {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .home-cta__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
  }

  .home-cta__title {
    font-size: var(--text-3xl);
  }

  .home-cta__text {
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .home-cta__actions {
    margin-top: var(--space-3);
  }
</style>
