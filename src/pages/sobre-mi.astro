---
import AboutBlock from '../components/AboutBlock.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sobre mí"
  description="Conoce a Marisa Peña Rey: desarrolladora web full-stack junior, formación DAW 2024–2026, prácticas con WordPress y experiencia con Laravel, JavaScript y MySQL."
>
  <section class="page">
    <div class="container">
      <SectionHeading index="2" title="Sobre mí" id="sobre-title" level="h1" size="xl" />
      <AboutBlock experienceHref="#experiencia" />
    </div>
  </section>

  <section class="page experience" id="experiencia" aria-labelledby="experiencia-title">
    <div class="container">
      <SectionHeading index="3" title="Experiencia y formación" id="experiencia-title" size="xl" />
      <ExperienceTimeline />
    </div>
  </section>
</BaseLayout>

<style>
  .experience {
    padding-top: 0;
  }
</style>
