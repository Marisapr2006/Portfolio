---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DossierMeta from '../components/DossierMeta.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'> | null;
}

const { project, next } = Astro.props;
const { title, summary, cover, year, gallery, confidential } = project.data;
---

<BaseLayout title={title} description={summary} ogType="article">
  <article class="project">
    <header class="project__header">
      <div class="container project__header-inner">
        <a class="project__back" href="/proyectos/">
          ← Todos los proyectos
        </a>
        <p class="page__eyebrow">{year} — Caso de estudio</p>
        <h1 class="project__title">{title}</h1>
        <p class="page__lead">{summary}</p>
      </div>
    </header>

    <div class="container project__cover-wrap">
      <Image
        class="project__cover"
        src={cover}
        alt={`Captura de la página de inicio de ${title}`}
        widths={[720, 1080, 1440]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="container">
      <DossierMeta project={project} />
      {confidential && (
        <p class="project__notice">
          Proyecto confidencial: el cliente no se nombra y no se publican enlaces privados.
        </p>
      )}
    </div>

    <div class="container project__content prose">
      <slot />
    </div>

    {gallery.length > 0 && (
      <div class="container project__gallery">
        {gallery.map((image, index) => (
          <Image
            class="project__gallery-image"
            src={image}
            alt={`Captura ${index + 1} de ${title}`}
            widths={[600, 1000]}
            sizes="(min-width: 900px) 50vw, 100vw"
            loading="lazy"
          />
        ))}
      </div>
    )}

    {next && (
      <nav class="container project__next" aria-label="Siguiente proyecto">
        <p class="page__eyebrow">Siguiente caso</p>
        <a class="project__next-link" href={`/proyectos/${next.id}/`}>
          {next.data.title}
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .project__header {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--space-6);
  }

  .project__header-inner {
    display: grid;
    gap: var(--space-4);
    max-width: 56rem;
    margin-inline: auto;
  }

  .project__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .project__title {
    font-size: var(--text-3xl);
  }

  .project__cover-wrap {
    padding-top: var(--space-6);
  }

  .project__cover {
    width: 100%;
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-lg);
  }

  .project__content {
    padding-block: var(--space-7) var(--space-8);
  }

  .project__content :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--text-2xl);
  }

  .project__content :global(h2:first-child) {
    margin-top: 0;
  }

  .project__content :global(p),
  .project__content :global(li) {
    max-width: var(--measure);
  }

  .project__content :global(ul),
  .project__content :global(ol) {
    padding-left: var(--space-5);
  }

  .project__notice {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .project__gallery {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
  }

  .project__gallery :global(.project__gallery-image) {
    width: 100%;
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hard);
  }

  @media (min-width: 900px) {
    .project__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .project__next {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--color-outline);
  }

  .project__next-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    text-decoration: none;
  }

  .project__next-link:hover {
    color: var(--color-primary);
  }
</style>
