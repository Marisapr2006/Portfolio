---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DossierMeta from '../components/DossierMeta.astro';
import Tag from '../components/Tag.astro';
import BaseLayout from './BaseLayout.astro';

interface ProjectHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  project: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'> | null;
  headings?: ProjectHeading[];
}

const { project, next, headings = [] } = Astro.props;
const { title, summary, cover, year, gallery, confidential, stack } = project.data;
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={summary} ogType="article">
  <article class="project">
    <header class="project__header">
      <div class="container project__header-inner">
        <nav class="project__breadcrumb" aria-label="Migas de pan">
          <a href="/proyectos/">proyectos</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{project.id}</span>
        </nav>

        <div class="project__intro">
          <div class="project__headline">
            <p class="mono-label project__eyebrow">
              // caso {year} · {project.id}
            </p>
            <h1 class="project__title">{title}</h1>
            <p class="page__lead">{summary}</p>
            <ul class="project__stack" aria-label={`Tecnologías de ${title}`}>
              {stack.map((item) => (
                <li>
                  <Tag>{item}</Tag>
                </li>
              ))}
            </ul>
          </div>

          <div class="project__meta">
            <p class="mono-label project__meta-label">// ficha</p>
            <DossierMeta project={project} confidential={confidential} />
          </div>
        </div>
      </div>
    </header>

    <div class="container project__cover-wrap">
      <figure class="project__cover-frame">
        <div class="project__cover-bar" aria-hidden="true">
          <span class="project__cover-dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="project__cover-file">captura / {project.id}</span>
        </div>
        <Image
          class="project__cover"
          src={cover}
          alt={`Captura de la página de inicio de ${title}`}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1200px) 1072px, calc(100vw - 8rem)"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="project__cover-caption">Portada del caso</figcaption>
      </figure>
    </div>

    <div class="container project__body">
      {sections.length > 0 && (
        <aside class="project__toc">
          <p class="mono-label project__toc-title">// en este caso</p>
          <nav aria-label="Contenido del caso">
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <div class="project__content">
        {confidential && (
          <p class="project__notice">
            Proyecto confidencial: el cliente no se nombra y no se publican enlaces privados.
          </p>
        )}

        <div class="prose">
          <slot />
        </div>
      </div>
    </div>

    {gallery.length > 0 && (
      <div class="container project__gallery">
        {gallery.map((image, index) => (
          <Image
            class="project__gallery-image"
            src={image}
            alt={`Captura ${index + 1} de ${title}`}
            widths={[600, 1000]}
            sizes="(min-width: 1200px) 528px, (min-width: 900px) 50vw, 100vw"
            loading="lazy"
          />
        ))}
      </div>
    )}

    {next && (
      <nav class="container project__next" aria-label="Siguiente proyecto">
        <p class="mono-label">// siguiente caso</p>
        <a class="project__next-link" href={`/proyectos/${next.id}/`}>
          <span>{next.data.title}</span>
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .project__header {
    padding-block: clamp(2rem, 5vw, 3.5rem) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .project__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .project__breadcrumb a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border-strong);
  }

  .project__breadcrumb a:hover {
    color: var(--color-primary);
  }

  .project__intro {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .project__headline {
    display: grid;
    gap: var(--space-4);
  }

  .project__eyebrow {
    color: var(--color-primary);
  }

  .project__title {
    font-size: var(--text-3xl);
    max-width: 16ch;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__meta {
    display: grid;
    gap: var(--space-2);
  }

  .project__meta-label {
    color: var(--color-primary);
  }

  .project__cover-wrap {
    padding-top: var(--space-6);
  }

  .project__cover-frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .project__cover-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.25rem;
    padding-inline: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .project__cover-dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .project__cover-dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .project__cover-dots span:first-child {
    background: var(--color-primary);
  }

  .project__cover-dots span:nth-child(2) {
    background: var(--color-accent);
  }

  .project__cover-file {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project__cover {
    width: 100%;
  }

  .project__cover-caption {
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project__body {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-8);
  }

  .project__toc {
    align-self: start;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .project__toc-title {
    margin-bottom: var(--space-3);
    color: var(--color-primary);
  }

  .project__toc ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .project__toc li {
    counter-increment: toc;
  }

  .project__toc a {
    display: flex;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    text-decoration: none;
  }

  .project__toc a::before {
    content: counter(toc, decimal-leading-zero);
    color: var(--color-border-strong);
  }

  .project__toc a:hover {
    color: var(--color-primary);
  }

  .project__content {
    min-width: 0;
  }

  .project__notice {
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .project__gallery {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
  }

  .project__gallery :global(.project__gallery-image) {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .project__next {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .project__next-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 650;
    text-decoration: none;
  }

  .project__next-link:hover {
    color: var(--color-primary);
  }

  @media (min-width: 600px) {
    .project__toc ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .project__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .project__intro {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-7);
    }

    .project__meta {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }

    .project__body {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .project__toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }

    .project__toc ol {
      grid-template-columns: 1fr;
    }
  }
</style>
