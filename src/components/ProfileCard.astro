---
interface Props {
  id?: string;
}

const { id = 'profile-card-caption' } = Astro.props;
---

<figure class="profile-card" aria-labelledby={id}>
  <div class="profile-card__bar" aria-hidden="true">
    <span class="profile-card__dots">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="profile-card__file">perfil.ts</span>
    <span class="profile-card__status">
      <span class="profile-card__status-dot"></span>
      open to work
    </span>
  </div>

  <pre
    class="profile-card__code"
    aria-hidden="true"
  ><code><span class="profile-card__line"><span class="tok-key">const</span> <span class="tok-var">marisa</span> <span class="tok-op">=</span> <span class="tok-brace">{"{"}</span></span><span class="profile-card__line profile-card__line--indent"><span class="tok-prop">role</span><span class="tok-op">:</span> <span class="tok-string">'full-stack developer'</span><span class="tok-op">,</span></span><span class="profile-card__line profile-card__line--indent"><span class="tok-prop">stack</span><span class="tok-op">:</span> <span class="tok-brace">{"["}</span><span class="tok-string">'Laravel'</span><span class="tok-op">,</span> <span class="tok-string">'JavaScript'</span><span class="tok-op">,</span> <span class="tok-string">'MySQL'</span><span class="tok-brace">{"]"}</span><span class="tok-op">,</span></span><span class="profile-card__line profile-card__line--indent"><span class="tok-prop">location</span><span class="tok-op">:</span> <span class="tok-string">'Las Palmas de GC'</span><span class="tok-op">,</span></span><span class="profile-card__line profile-card__line--indent"><span class="tok-prop">status</span><span class="tok-op">:</span> <span class="tok-string">'open to work'</span><span class="tok-op">,</span></span><span class="profile-card__line"><span class="tok-brace">{"}"}</span><span class="tok-op">;</span></span></code></pre>

  <figcaption class="visually-hidden" id={id}>
    Ficha de perfil: desarrolladora web full-stack, Laravel, JavaScript y MySQL, en Las Palmas de
    Gran Canaria, abierta a oportunidades.
  </figcaption>
</figure>

<style>
  .profile-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-code-bg);
    color: var(--color-code-text);
  }

  .profile-card__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.5rem;
    padding-inline: var(--space-3);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    background: var(--color-code-bar);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .profile-card__dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .profile-card__dots span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-code-muted);
    opacity: 0.55;
  }

  .profile-card__dots span:nth-child(1) {
    background: var(--color-primary);
    opacity: 1;
  }

  .profile-card__dots span:nth-child(2) {
    background: var(--color-code-string);
    opacity: 0.8;
  }

  .profile-card__file {
    color: var(--color-code-text);
  }

  .profile-card__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    color: var(--color-code-string);
    text-transform: uppercase;
  }

  .profile-card__status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-code-string);
  }

  .profile-card__code {
    margin: 0;
    padding: var(--space-5);
    overflow-x: auto;
    color: var(--color-code-text);
    font-size: clamp(0.72rem, 0.65rem + 0.3vw, 0.82rem);
    line-height: 1.8;
    tab-size: 2;
  }

  .profile-card__line {
    display: block;
    white-space: pre;
  }

  .profile-card__line--indent {
    padding-left: 1.5ch;
  }

  .tok-key {
    color: var(--color-code-key);
  }

  .tok-var,
  .tok-prop {
    color: var(--color-code-text);
  }

  .tok-string {
    color: var(--color-code-string);
  }

  .tok-op,
  .tok-brace {
    color: var(--color-code-muted);
  }

  @media (max-width: 420px) {
    .profile-card__status {
      display: none;
    }
  }
</style>
