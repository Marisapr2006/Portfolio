---
import type { CollectionEntry } from 'astro:content';
import { projectStatusLabel } from '../data/projects';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { role, year, status, stack, repo, demo, video } = project.data;

const links = [
  demo ? { href: demo, label: 'Demo online' } : null,
  repo ? { href: repo, label: 'Repositorio' } : null,
  video ? { href: video, label: 'Vídeo' } : null,
].filter((link): link is { href: string; label: string } => link !== null);
---

<dl class="dossier-meta">
  <div class="dossier-meta__item">
    <dt>Rol</dt>
    <dd>{role}</dd>
  </div>

  <div class="dossier-meta__item">
    <dt>Año</dt>
    <dd>{year}</dd>
  </div>

  <div class="dossier-meta__item">
    <dt>Estado</dt>
    <dd>{projectStatusLabel(status)}</dd>
  </div>

  <div class="dossier-meta__item">
    <dt>Stack</dt>
    <dd>
      <ul class="dossier-meta__list">
        {stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </dd>
  </div>

  {links.length > 0 && (
    <div class="dossier-meta__item">
      <dt>Enlaces</dt>
      <dd>
        <ul class="dossier-meta__list">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  )}
</dl>

<style>
  .dossier-meta {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard);
  }

  .dossier-meta__item {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .dossier-meta dt {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dossier-meta dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .dossier-meta__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .dossier-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .dossier-meta {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
