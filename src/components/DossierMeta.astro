---
import type { CollectionEntry } from 'astro:content';
import { projectStatusLabel } from '../data/projects';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  confidential?: boolean;
}

const { project, confidential = false } = Astro.props;
const { role, year, status, stack, repo, demo, video } = project.data;

const links = [
  demo ? { href: demo, label: 'Demo online' } : null,
  repo ? { href: repo, label: 'Repositorio' } : null,
  video ? { href: video, label: 'Vídeo' } : null,
].filter((link): link is { href: string; label: string } => link !== null);
---

<dl class="dossier-meta">
  <div class="dossier-meta__row">
    <dt>Rol</dt>
    <dd>{role}</dd>
  </div>

  <div class="dossier-meta__row">
    <dt>Año</dt>
    <dd>{year}</dd>
  </div>

  <div class="dossier-meta__row">
    <dt>Estado</dt>
    <dd>{projectStatusLabel(status)}</dd>
  </div>

  <div class="dossier-meta__row">
    <dt>Stack</dt>
    <dd>
      <ul class="dossier-meta__stack">
        {stack.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
      </ul>
    </dd>
  </div>

  {!confidential && links.length > 0 && (
    <div class="dossier-meta__row">
      <dt>Enlaces</dt>
      <dd>
        <ul class="dossier-meta__links">
          {links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  )}
</dl>

<style>
  .dossier-meta {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .dossier-meta__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .dossier-meta__row:last-child {
    border-bottom: 0;
  }

  .dossier-meta dt {
    padding-top: 0.15rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dossier-meta dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .dossier-meta__stack,
  .dossier-meta__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dossier-meta__links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
  }
</style>
