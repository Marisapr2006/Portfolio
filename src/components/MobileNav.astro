---
import { navigation } from '../data/site';
---

<div class="mobile-nav" data-mobile-nav>
  <button
    class="mobile-nav__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    aria-label="Abrir menú"
    data-mobile-nav-toggle
  >
    <span aria-hidden="true">Menú</span>
  </button>

  <div class="mobile-nav__panel" id="mobile-nav-panel" hidden data-mobile-nav-panel>
    <nav class="mobile-nav__inner" aria-label="Menú móvil">
      <ul class="mobile-nav__list">
        {navigation.map((link) => (
          <li>
            <a
              class="mobile-nav__link"
              href={link.href}
              aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<style>
  .mobile-nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mobile-nav__toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .mobile-nav__panel {
    position: fixed;
    inset: var(--header-height) 0 auto;
    z-index: 15;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav__panel[hidden] {
    display: none;
  }

  .mobile-nav__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-4) var(--container-padding) var(--space-5);
  }

  .mobile-nav__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav__link {
    display: block;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-nav__link[aria-current='page'] {
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none;
    }
  }
</style>
