---
import { timeline } from '../data/experience';
import { site } from '../data/site';
---

<p class="timeline__lead" data-reveal>
  Mi primera experiencia en empresa y la formación que hay detrás.
</p>

<div class="timeline" data-timeline>
  <span class="timeline__line" aria-hidden="true" data-timeline-line></span>

  <ol class="timeline__list">
    {timeline.map((entry, index) => (
      <li class="timeline__item" data-reveal>
        <span class:list={['timeline__node', `timeline__node--${index % 3}`]} aria-hidden="true" />
        <article class:list={['timeline__card', `timeline__card--${index % 3}`]}>
          <div class="timeline__aside">
            <p class="timeline__period">
              {entry.period}
              <span aria-hidden="true"> / </span>
              {entry.kind}
            </p>
            {entry.duration && (
              <p class="timeline__duration">
                <span class="timeline__duration-value">{entry.duration.value}</span>
                <span class="timeline__duration-unit">{entry.duration.unit}</span>
              </p>
            )}
          </div>

          <div class="timeline__body">
            <h3 class="timeline__title">{entry.title}</h3>
            {entry.organization && <p class="timeline__org">{entry.organization}</p>}
            {entry.summary && <p class="timeline__summary">{entry.summary}</p>}

            {entry.tasks && (
              <ul class="timeline__tasks">
                {entry.tasks.map((task) => (
                  <li>
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 12.5l5 5L20 6.5"></path>
                    </svg>
                    {task}
                  </li>
                ))}
              </ul>
            )}

            {entry.finalProject && (
              <div class="timeline__final">
                <p class="timeline__final-label">Proyecto final</p>
                <p>{entry.finalProject}</p>
              </div>
            )}

            {entry.tags && (
              <ul class="timeline__tags">
                {entry.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>

  <div class="actions timeline__actions" data-reveal>
    <a class="button button--primary" href={site.cv} download>
      Descargar CV
      <span aria-hidden="true">↓</span>
    </a>
    <a class="button button--secondary" href="/contacto/">
      Hablemos
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .timeline {
    position: relative;
    padding-left: 4rem;
  }

  .timeline__line {
    position: absolute;
    top: var(--space-2);
    bottom: var(--space-2);
    left: 0.8rem;
    width: 2px;
    background: var(--color-accent);
    transform-origin: top;
  }

  .timeline__lead {
    max-width: 40ch;
    margin-bottom: var(--space-7);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .timeline__actions {
    margin-top: var(--space-7);
  }

  .timeline__list {
    display: grid;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
  }

  .timeline__node {
    position: absolute;
    top: 1.75rem;
    left: calc(-4rem + 0.2rem);
    width: 1.1rem;
    height: 1.1rem;
    border: var(--border-width) solid var(--color-outline);
    background: var(--color-accent);
    box-shadow: 3px 3px 0 var(--color-shadow);
    transform: rotate(45deg);
  }

  .timeline__node--1 {
    background: var(--color-primary);
  }

  .timeline__node--2 {
    background: var(--color-text);
  }

  .timeline__card {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 3.5vw, 2.5rem);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-lg);
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .timeline__card--1 {
    border-color: var(--color-outline-alt);
    box-shadow: 8px 8px 0 var(--color-shadow-alt);
  }

  .timeline__card--2 {
    border-color: var(--color-text);
  }

  .timeline__card--1 .timeline__period {
    color: var(--color-primary);
  }

  .timeline__card--2 .timeline__period {
    color: var(--color-text);
  }

  .timeline__card:hover {
    transform: translateY(-5px);
  }

  .timeline__aside {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    align-content: start;
  }

  .timeline__period {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .timeline__duration {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    box-shadow: var(--shadow-hard-sm);
    color: var(--color-on-accent);
    transform: rotate(-4deg);
  }

  .timeline__duration-value {
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .timeline__duration-unit {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .timeline__body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .timeline__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .timeline__org {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .timeline__summary {
    max-width: 60ch;
    color: var(--color-text-muted);
  }

  .timeline__tasks {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .timeline__tasks li {
    display: flex;
    gap: var(--space-3);
  }

  .timeline__tasks svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--color-accent);
  }

  .timeline__final {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  .timeline__final-label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .timeline__card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }
</style>
