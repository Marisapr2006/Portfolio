---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { projectStatusLabel } from '../data/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  headingLevel?: 'h2' | 'h3';
}

const { project, index, headingLevel = 'h3' } = Astro.props;
const { title, summary, year, role, stack, cover, status } = project.data;
const number = String(index + 1).padStart(2, '0');
const Heading = headingLevel;
---

<article class="project-card" data-reveal>
  <a class="project-card__link" href={`/proyectos/${project.id}/`}>
    <div class="project-card__media">
      <span class="project-card__index" aria-hidden="true">
        {number}
      </span>
      <Image
        src={cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 44vw, 100vw"
        loading="lazy"
      />
    </div>

    <div class="project-card__body">
      <p class="project-card__meta">
        <span>{year}</span>
        <span aria-hidden="true">/</span>
        <span>{role}</span>
        <span aria-hidden="true">/</span>
        <span>{projectStatusLabel(status)}</span>
      </p>

      <Heading class="project-card__title">{title}</Heading>
      <p class="project-card__summary">{summary}</p>

      <ul class="project-card__stack" aria-label={`Tecnologías de ${title}`}>
        {stack.map((item) => (
          <li class="chip">{item}</li>
        ))}
      </ul>

      <span class="project-card__cta" aria-hidden="true">
        Leer el caso completo
        <span class="project-card__arrow">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .project-card + .project-card {
    margin-top: var(--space-7);
  }

  .project-card__link {
    display: grid;
    overflow: hidden;
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-lg);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-spring),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .project-card__link:hover {
    color: var(--color-text);
    transform: translateY(-6px);
    box-shadow: 10px 12px 0 var(--color-shadow-hover);
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--color-outline);
    background: var(--color-surface-sunken);
  }

  .project-card__index {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-outline);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .project-card__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .project-card__link:hover .project-card__media img {
    transform: scale(1.04);
  }

  .project-card__body {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-card__title {
    font-size: var(--text-3xl);
  }

  .project-card__summary {
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    min-height: 44px;
    padding: 0 var(--space-5);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    box-shadow: var(--shadow-hard-sm);
    color: var(--color-on-accent);
    font-weight: 800;
  }

  .project-card__arrow {
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .project-card__link:hover .project-card__arrow {
    transform: translateX(0.4rem);
  }

  @media (min-width: 900px) {
    .project-card__link {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .project-card__media {
      border-right: var(--border-width) solid var(--color-outline);
      border-bottom: 0;
    }

    .project-card__media img {
      height: 100%;
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }
</style>
