---
import { site } from '../data/site';
---

<div class="copy-email">
  <a class="button button--primary" href={`mailto:${site.email}`}>
    Escríbeme
  </a>
  <button class="button button--secondary" type="button" data-copy-email={site.email}>
    Copiar email
  </button>
  <p class="copy-email__status" data-copy-email-status role="status" aria-live="polite">
    Email no copiado todavía
  </p>
</div>

<script>
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');

  if (copyEmailButton) {
    const copyEmailStatus = document.querySelector<HTMLElement>(
      '[data-copy-email-status]:not(button)',
    );
    const originalText = copyEmailButton.textContent ?? '';

    const setStatus = (message: string): void => {
      if (copyEmailStatus) {
        copyEmailStatus.textContent = message;
      }
    };

    const copyToClipboard = async (text: string): Promise<boolean> => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }

      return false;
    };

    copyEmailButton.addEventListener('click', async () => {
      const text = copyEmailButton.getAttribute('data-copy-email');
      const ok = text ? await copyToClipboard(text) : false;

      setStatus(ok ? 'Email copiado al portapapeles' : 'No se pudo copiar el email');

      if (ok) {
        window.setTimeout(() => {
          copyEmailButton.textContent = originalText;
          setStatus('Email no copiado todavía');
        }, 3000);
      }
    });
  }
</script>

<style>
  .copy-email {
    display: grid;
    gap: var(--space-2);
  }

  .copy-email__status {
    min-height: 1.25rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }
</style>
